{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "color": {
            "keys": "#A3BE8C"                                // nord14 green: outer frame + system block
        },
        "separator": "",
        "constants": [
            "──────────────────────────────────────────────", // {$1} inner border
            "\u001b[47D",                                     // {$2} cursor left 47
            "\u001b[47C",                                     // {$3} cursor right 47
            "\u001b[46C",                                     // {$4} cursor right 46
            "══════════════════════════════════════════════"  // {$5} outer border
        ],
        "brightColor": false
    },
    "modules": [
        {
            "type": "version",
            "key": "╔═══════════════╦═{$5}╗\u001b[41D",
            "format": "\u001b[1m{#keys} {1} - {2} "
        },

        {
            "type": "os",
            "key": "║  {icon}  OS        ║{$3}║{$2}"
        },
        {
            "type": "kernel",
            "key": "║  {icon}  Kernel    ║{$3}║{$2}"
        },
        {
            "type": "packages",
            "key": "║  {icon}  Packages  ║{$3}║{$2}"
        },
        {
            "type": "locale",
            "key": "║  {icon}  Locale    ║{$3}║{$2}"
        },

        // Terminal section: nord13 yellow
        {
            "type": "custom",
            "key": "║{##EBCB8B}┌──────────────┬{$1}┐{#keys}║\u001b[37D",
            "format": "{##EBCB8B} Terminal "
        },
        {
            "type": "shell",
            "key": "║{##EBCB8B}│ {icon}  Shell     │{$4}│{#keys}║{$2}"
        },
        {
            "type": "terminal",
            "key": "║{##EBCB8B}│ {icon}  Terminal  │{$4}│{#keys}║{$2}"
        },
        {
            "type": "terminalfont",
            "key": "║{##EBCB8B}│ {icon}  Font      │{$4}│{#keys}║{$2}"
        },
        {
            "type": "custom",
            "key": "║{##EBCB8B}└──────────────┴{$1}┘{#keys}║",
            "format": ""
        },

        // Hardware section: nord11 red
        {
            "type": "custom",
            "key": "║{##BF616A}┌──────────────┬{$1}┐{#keys}║\u001b[37D",
            "format": "{##BF616A} Hardware "
        },
        {
            "type": "cpu",
            "key": "║{##BF616A}│ {icon}  CPU       │{$4}│{#keys}║{$2}",
            "format": "{name} ({cores-physical})"
        },
        {
            "type": "gpu",
            "key": "║{##BF616A}│ {icon}  GPU       │{$4}│{#keys}║{$2}",
            "format": "{vendor} {name} @ {frequency}"
        },
        {
            "type": "memory",
            "key": "║{##BF616A}│ {icon}  RAM       │{$4}│{#keys}║{$2}"
        },
        {
            "type": "swap",
            "key": "║{##BF616A}│ {icon}  SWAP      │{$4}│{#keys}║{$2}"
        },
        {
            "type": "disk",
            "key": "║{##BF616A}│ {icon}  Disk      │{$4}│{#keys}║{$2}",
            "format": "{size-used} \/ {size-total} ({size-percentage}) - {filesystem}"
        },
        {
            "type": "custom",
            "key": "║{##BF616A}└──────────────┴{$1}┘{#keys}║",
            "format": ""
        },

        // Network section: nord15 magenta
        {
            "type": "custom",
            "key": "║{##B48EAD}┌──────────────┬{$1}┐{#keys}║\u001b[37D",
            "format": "{##B48EAD} Network "
        },
        {
            "type": "localip",
            "defaultRouteOnly": false,
            "key": "║{##B48EAD}│ {icon}  Local IP  │{$4}│{#keys}║{$2}"
        },
        {
            "type": "publicip",
            "key": "║{##B48EAD}│ {icon}  Public IP │{$4}│{#keys}║{$2}"
        },
        {
            "type": "dns",
            "showType": "ipv4",
            "key": "║{##B48EAD}│ {icon}  DNS       │{$4}│{#keys}║{$2}"
        },
        {
            "type": "custom",
            "key": "║{##B48EAD}└──────────────┴{$1}┘{#keys}║",
            "format": ""
        },

        // Uptime section: nord10 blue
        {
            "type": "custom",
            "key": "║{##5E81AC}┌──────────────┬{$1}┐{#keys}║\u001b[37D",
            "format": "{##5E81AC} Uptime "
        },
        {
            "type": "uptime",
            "key": "║{##5E81AC}│ {icon}  Uptime    │{$4}│{#keys}║{$2}"
        },
        {
            "type": "custom",
            "key": "║{##5E81AC}└──────────────┴{$1}┘{#keys}║",
            "format": ""
        },

        {
            "type": "custom",
            "key": "╚═════════════════{$5}╝",
            "format": ""
        },

        "break",
        "colors"
    ]
}
