{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "color": {
            "keys": "#5E81AC"
        },
        "separator": "",
        "constants": [
            "──────────────────────────────────────────────", // {$1} inner border
            "\u001b[47D",                                     // {$2} cursor left 47
            "\u001b[47C",                                     // {$3} cursor right 47
            "\u001b[46C",                                     // {$4} cursor right 46
            "══════════════════════════════════════════════"  // {$5} outer border
        ],
        "brightColor": false
    },
    "modules": [
        {
            "type": "version",
            "key": "╔═══════════════╦═{$5}╗\u001b[41D",
            "format": "\u001b[1m{#keys} {1} - {2} "
        },

        {
            "type": "os",
            "key": "║  {icon}  OS        ║{$3}║{$2}"
        },
        {
            "type": "kernel",
            "key": "║  {icon}  Kernel    ║{$3}║{$2}"
        },
        {
            "type": "uptime",
            "key": "║  {icon}  Uptime    ║{$3}║{$2}"
        },
        {
            "type": "packages",
            "key": "║  {icon}  Packages  ║{$3}║{$2}"
        },
        {
            "type": "locale",
            "key": "║  {icon}  Locale    ║{$3}║{$2}"
        },

        {
            "type": "custom",
            "key": "║{##5E81AC}┌──────────────┬{$1}┐{#keys}║\u001b[37D",
            "format": "{##5E81AC} Terminal "
        },
        {
            "type": "shell",
            "key": "║{##5E81AC}│ {icon}  Shell     │{$4}│{#keys}║{$2}"
        },
        {
            "type": "terminal",
            "key": "║{##5E81AC}│ {icon}  Terminal  │{$4}│{#keys}║{$2}"
        },
        {
            "type": "custom",
            "key": "║{##5E81AC}└──────────────┴{$1}┘{#keys}║",
            "format": ""
        },

        {
            "type": "custom",
            "key": "║{##5E81AC}┌──────────────┬{$1}┐{#keys}║\u001b[37D",
            "format": "{##5E81AC} Hardware "
        },
        {
            "type": "cpu",
            "key": "║{##5E81AC}│ {icon}  CPU       │{$4}│{#keys}║{$2}"
        },
        {
            "type": "gpu",
            "key": "║{##5E81AC}│ {icon}  GPU       │{$4}│{#keys}║{$2}"
        },
        {
            "type": "memory",
            "key": "║{##5E81AC}│ {icon}  RAM       │{$4}│{#keys}║{$2}"
        },
        {
            "type": "swap",
            "key": "║{##5E81AC}│ {icon}  SWAP      │{$4}│{#keys}║{$2}"
        },
        {
            "type": "disk",
            "key": "║{##5E81AC}│ {icon}  Disk      │{$4}│{#keys}║{$2}",
            "format": "{size-used} \/ {size-total} ({size-percentage}) - {filesystem}"
        },
        {
            "type": "custom",
            "key": "║{##5E81AC}└──────────────┴{$1}┘{#keys}║",
            "format": ""
        },

        {
            "type": "custom",
            "key": "║{##5E81AC}┌──────────────┬{$1}┐{#keys}║\u001b[37D",
            "format": "{##5E81AC} Network "
        },
        {
            "type": "localip",
            "key": "║{##5E81AC}│ {icon}  Local IP  │{$4}│{#keys}║{$2}"
        },
        {
            "type": "publicip",
            "key": "║{##5E81AC}│ {icon}  Public IP │{$4}│{#keys}║{$2}"
        },
        {
            "type": "custom",
            "key": "║{##5E81AC}└──────────────┴{$1}┘{#keys}║",
            "format": ""
        },

        {
            "type": "custom",
            "key": "╚═════════════════{$5}╝",
            "format": ""
        },

        "break",
        "colors"
    ]
}
