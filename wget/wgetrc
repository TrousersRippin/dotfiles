# ~/.wgetrc
# Global config file for wget. Wget reads $HOME/.wgetrc automatically
# on startup. Format is "option = value" (one per line); boolean
# options take "on"/"off". Long-form option names are used throughout
# instead of short flags for clarity.
#
# Note: wget's config keys drop the leading "--" from the CLI flag but
# otherwise match it, e.g. CLI "--tries=5" becomes "tries = 5" here.

# --- Retries & timeouts --------------------------------------------------

# Number of retries on a failed download before giving up.
tries = 5

# Seconds to wait before retrying after a failure. wget backs this off
# automatically on repeated failures.
waitretry = 5

# Timeout (seconds) for both DNS lookups and the connection attempt.
dns_timeout = 10
connect_timeout = 10

# Timeout (seconds) for reading data once connected — resets each time
# data arrives, so this catches stalled (not just slow) transfers.
read_timeout = 60

# --- Redirects & robustness ------------------------------------------------

# Treat a server that sends a redirect to itself, or too many
# redirects, as an error rather than looping.
max_redirect = 20

# Keep going on a broken/interrupted download by continuing an existing
# partial file instead of restarting from scratch.
continue = on

# --- Politeness / site-friendliness ---------------------------------------

# Pause between requests to avoid hammering a server (seconds).
wait = 1

# Randomize the wait time (0.5x to 1.5x of "wait") so bulk downloads
# don't look like a scripted attack pattern to the remote server.
random_wait = on

# Respect robots.txt when doing recursive/mirror downloads.
robots = on

# --- Output ----------------------------------------------------------------

# Show download progress as a bar rather than the verbose dot-meter.
progress = bar

# Keep wget's own log timestamps out of the progress display; still
# shows errors and summary info.
quiet = off
verbose = off

# --- File handling ----------------------------------------------------------

# Don't overwrite an existing local file; append a .1, .2, etc. suffix
# instead, so repeated runs never clobber prior downloads.
noclobber = on

# Preserve the remote server's file modification timestamp on the
# downloaded file (mirrors curl's --remote-time behavior).
timestamping = on

# --- Security ----------------------------------------------------------

# Verify SSL/TLS certificates (this is wget's default; listed here so
# it's explicit and never silently overridden by --no-check-certificate
# in a personal alias).
check_certificate = on

# --- Identity ----------------------------------------------------------

# Custom User-Agent string. Some sites block wget's default UA.
user_agent = "wget/mac-mini"
